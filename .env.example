# TheBus HEA API — register at https://hea.thebus.org/api_info.asp
# Copy to .env.local and replace the placeholder for live arrivals.
# Without a key, the app uses official GTFS stops and scheduled services.
THEBUS_API_KEY=PASTE_KEY_HERE

# Bun API server configuration.
API_PORT=3001
API_ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# Leave blank in local web/Tauri development so Vite proxies /api.
# Production web and Tauri builds must point to the deployed Bun API.
VITE_API_BASE_URL=

# Optional: serve the built website and API together (used by render.yaml).
# Run bun run build before enabling this. Hosting PORT overrides API_PORT.
# STATIC_SITE_DIR=dist
