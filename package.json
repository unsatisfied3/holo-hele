{
  "name": "holehele",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:web dev:api",
    "dev:web": "bun x --bun vite",
    "dev:api": "bun --hot server/index.ts",
    "build": "bun run typecheck && bun x --bun vite build",
    "build:web": "bun x --bun vite build",
    "api": "bun server/index.ts",
    "lint": "eslint .",
    "test:unit": "bun test server/gtfs-csv.test.ts server/static-site.test.ts server/service-alerts.test.ts server/walking-directions.test.ts lib/service-alerts.test.ts lib/notifications.test.ts lib/trip-guidance.test.ts",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-notification": "^2",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@tanstack/router-plugin": "^1.168.22",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.3.14",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5"
  }
}
